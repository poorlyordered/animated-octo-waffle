{
  "name": "gryyk-47-greenfield",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "packages/contracts"
  ],
  "scripts": {
    "build": "npm run build --workspace @gryyk/contracts && npm run build --workspace @gryyk/web",
    "dev": "npm run dev --workspace @gryyk/web",
    "dev:netlify": "netlify dev --filter @gryyk/web --port 8888",
    "lint": "eslint apps netlify packages eslint.config.js",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest.config.cjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest.config.cjs --watch",
    "typecheck": "tsc --build"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "mongodb": "^7.0.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.60.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.11",
    "typescript-eslint": "^8.60.0"
  },
  "engines": {
    "node": "22.x"
  }
}
