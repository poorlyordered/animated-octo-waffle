{
  "name": "gryyk-47-greenfield",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "packages/contracts"
  ],
  "scripts": {
    "build": "npm run build --workspace @gryyk/contracts && npm run build --workspace @gryyk/web",
    "dev": "npm run dev --workspace @gryyk/web",
    "lint": "eslint apps netlify packages eslint.config.js",
    "test": "vitest run --config apps/web/vitest.config.ts",
    "test:watch": "vitest --config apps/web/vitest.config.ts",
    "typecheck": "tsc --build"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "mongodb": "^7.0.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^27.2.0",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.0.14"
  },
  "engines": {
    "node": "22.x"
  }
}
